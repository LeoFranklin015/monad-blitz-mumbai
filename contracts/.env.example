# Deployer (becomes owner of every contract). Use a hardware wallet or a key you move to a multisig after deploy.
PRIVATE_KEY=

# RPC overrides
MONAD_RPC=https://rpc.monad.xyz
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Roles (addresses of the backend keys)
KEEPER_ADDRESS=
REPORTER_ADDRESS=
HEDGER_ADDRESS=
GUARDIAN_ADDRESS=      # can pause new risk instantly; a hot ops key or a monitoring bot
MAKER_OPERATOR=        # operator of the HedgedMaker contract

# Live tokens instead of mocks. Use non-rebasing (wrapped) xStocks.
USE_REAL_TOKENS=       # USDC=0x..,NVDAx=0x..,TSLAx=0x..,SPYx=0x..
MULTIPLIER_SOURCES=    # NVDAx=0x.. contract exposing multiplier() for each wrapped xStock

# Pyth settlement (recommended on live networks)
PYTH_ADDRESS=
PYTH_IDS=              # NVDAx=0x..,TSLAx=0x..,SPYx=0x.. per-share price ids

# Spot venue adapter for HedgedMaker (IDexRouter). Leave empty on mainnet until a Kuru adapter is deployed.
DEX_ROUTER=

# First expiry in minutes from now (default: next Monday 13:30 UTC)
EXPIRY_MINUTES=

# Contract verification
ETHERSCAN_API_KEY=
