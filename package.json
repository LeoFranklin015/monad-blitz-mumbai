{
  "name": "weekend-options",
  "private": true,
  "description": "Fully onchain options on tokenized stocks, built for Monad",
  "workspaces": [
    "contracts",
    "backend",
    "web"
  ],
  "scripts": {
    "test": "npm test -w contracts",
    "chain": "npm run node -w contracts",
    "deploy:local": "npm run deploy:local -w contracts",
    "deploy:monad": "npm run deploy:monad -w contracts",
    "deploy:monad-testnet": "npm run deploy:monad-testnet -w contracts",
    "deploy:base-sepolia": "npm run deploy:base-sepolia -w contracts",
    "backend": "npm start -w backend",
    "web": "npm run dev -w web",
    "build": "npm run build -w web"
  }
}
