# Which deployment to run against: deployments/<NETWORK>.json
NETWORK=monad
# Optional: override the RPC from the deployment file (use a private RPC in production)
RPC_URL=

# One key per role. Fund each with native gas. Never reuse the deployer/owner key here.
REPORTER_KEY=          # only for the reporter oracle; with Pyth anyone can submit, this pays update fees
KEEPER_KEY=            # settles, pays out, rolls vaults and expiries, opens gap rounds; needs USDC to liquidate
MAKER_KEYS=            # comma-separated; the first one also signs RFQ quotes
OPERATOR_KEY=          # operator of the HedgedMaker contract
HEDGER_KEY=            # wallet that hedges the bot makers' delta on spot

# API
PORT=8787
CORS_ORIGINS=https://your-app.example
RATE_LIMIT_PER_MIN=120
RFQ_TTL_SEC=60
RFQ_SPREAD=0.03
RFQ_MAX_SIZE=500

# Quoting
TICK_MS=1000
REQUOTE_BPS=100
ASK_SIZE=25
BID_SIZE=15
MAKER_AUTO_DEPOSIT=1   # 0 = makers only quote what you deposit yourself

# Risk
MAX_STALE_SEC=120
JUMP_PCT=0.06
JUMP_COOLDOWN_SEC=60
STOP_BEFORE_EXPIRY_SEC=300
MAX_SHORT_DELTA=5000

# Hedging: off | mockdex | kuru
HEDGE_MODE=kuru
HEDGE_THRESHOLD=1
HEDGE_MAX_SLIPPAGE_BPS=100
KURU_API_URL=https://ws.kuru.io/api
KURU_AMOUNT_FORMAT=decimal   # decimal | raw, match Kuru's quote API

# Pyth (when the deployment uses PythSettlementOracle)
HERMES_URL=https://hermes.pyth.network
PYTH_IDS=NVDAx=0x...,TSLAx=0x...,SPYx=0x...

# Chain reading
LOG_CHUNK=500
CONFIRMATIONS=2

# Ops
DATA_DIR=./data
LOG_FORMAT=json
