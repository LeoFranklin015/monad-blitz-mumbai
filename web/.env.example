# Which deployment to load from public/deployments/<network>.json
VITE_NETWORK=localhost

# Backend API (markets + RFQ)
VITE_API_URL=http://localhost:8787

# Optional frontend RPC override. By default chain reads use the backend's /rpc proxy.
VITE_RPC_URL=

# JAW passkey accounts (https://dashboard.jaw.id). Supported chains include Monad (143) and Base Sepolia (84532).
VITE_JAW_API_KEY=

# Optional full gas sponsorship: an EntryPoint v0.8 / ERC-7677 paymaster URL for the deployment's chain
VITE_PAYMASTER_URL=

# Max price drift accepted between quote and inclusion, in basis points (a limit, not a fee)
VITE_SLIPPAGE_BPS=500
